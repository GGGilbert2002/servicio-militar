# PROYECTO: Plataforma de análisis territorial - Servicio Militar Coro
# Copia este archivo a .env y ajusta los valores según tu máquina

# ---------- CONFIGURACIÓN DE BASE DE DATOS ----------
# Para SQLite local: usa una ruta absoluta o relativa
# Ejemplo relativo: data/servicio_militar.db
DATABASE_PATH=data/servicio_militar.db

# ---------- CONFIGURACIÓN DE LA APLICACIÓN ----------
# Nombre que aparece en la ventana principal
APP_NAME="Sistema de Reclutamiento - Coro"

# Tamaño de la ventana principal (ancho x alto)
WINDOW_SIZE="1024x768"

# ---------- LISTA DE PARROQUIAS (separadas por comas) ----------
# Esta variable sobreescribe la lista por defecto de config.py
PARROQUIAS_CORO="San Antonio,San Gabriel,Santa Ana,San Nicolás,San Clemente,San José"

# ---------- OPCIONES DE DEPURACIÓN ----------
# DEBUG=True activa logs más detallados (no usar en producción)
DEBUG=False